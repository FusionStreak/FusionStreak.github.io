{
	"mcpServers": {
		"nextjs": {
			"type": "local",
			"command": "pnpm",
			"args": [
				"dlx",
				"next-devtools-mcp@latest"
			],
			"tools": [
				"*"
			]
		},
		"shadcn": {
			"type": "local",
			"command": "pnpm",
			"args": [
				"dlx",
				"shadcn@latest",
				"mcp"
			],
			"tools": [
				"*"
			]
		}
	}
}
